{#- Blocs de balisage partagés par plusieurs modèles.
    Les maquettes d'écran existent en deux styles : « qt » (pages des cas d'usage) et « dc » (vitrine de l'offre). -#}

{#- Encart de fin de page pour réserver un audit ; anchor et alt servent à la page de l'offre #}
{% macro cta(title, text, button, anchor, alt) %}<section class="cta grid-paper"{% if anchor %} id="{{ anchor }}"{% endif %} aria-labelledby="t-audit">
    <div class="wrap">
      <h2 id="t-audit">{{ title }}</h2>
      <p>{{ text }}</p>
      <a data-book class="btn"{% if anchor %} id="{{ anchor }}-link"{% endif %} target="_blank" rel="noopener">{{ button }}</a>
{% if alt %}      <p class="cta-alt">{{ alt }}</p>
{% endif %}    </div>
  </section>{% endmacro %}

{#- Maquettes : menu latéral avec le nom de l'application (mark : la pastille de couleur devant le nom) #}
{% macro sidebar(kind, brand, items, mark) %}<aside class="{{ kind }}-side"><p class="{{ kind }}-brand">{% if mark %}<em></em>{% endif %}{{ brand }}</p><ul>{% for item in items %}<li{% if item.on %} class=on{% endif %}>{{ item.label }}</li>{% endfor %}</ul></aside>{% endmacro %}

{#- Maquettes : en-tête d'écran (titres, et un bouton ou un statut à droite) #}
{% macro screenHead(kind, titles, buttonClass, button) %}<div class="{{ kind }}-head"><div>{% for title in titles %}<p class="{{ title.class }}">{{ title.label }}</p>{% endfor %}</div>{% if button %}<span class="{{ buttonClass }}">{{ button }}</span>{% endif %}</div>{% endmacro %}

{#- Maquettes : tableau, une ligne par élément de rows (classe de la ligne et cellules) #}
{% macro table(class, style, rows) %}<div class="{{ class }}" style="{{ style }}">{% for row in rows %}<div class="{{ row.class }}">{% for cell in row.items %}<span>{{ cell }}</span>{% endfor %}</div>{% endfor %}</div>{% endmacro %}

{#- Maquettes : ligne de planning, des interventions placées par leur style #}
{% macro lane(class, jobs, jobClass) %}<div class="{{ class }}">{% for job in jobs %}<span class="{{ jobClass }}" style="{{ job.style }}">{{ job.label }}</span>{% endfor %}</div>{% endmacro %}

{#- Maquettes : barres de progression #}
{% macro progress(rows) %}<div class="dc-panel dc-grow">{% for row in rows %}<div class="dc-prog"><span>{{ row.span }}</span><div><i style="{{ row.iStyle }}"></i></div><b>{{ row.b }}</b></div>{% endfor %}</div>{% endmacro %}

{#- Maquettes : élément de liste (valeur en gras, libellé et détail) #}
{% macro listItem(class, b, span, small) %}<div class="{{ class }}"><b>{{ b }}</b><div><span>{{ span }}</span><small>{{ small }}</small></div></div>{% endmacro %}

{#- Maquettes : champ validé #}
{% macro checkedField(label, value) %}<div class="mk-field"><span>{{ label }}</span><b>{{ value }}</b><span class="mk-pill mk-ok">✓</span></div>{% endmacro %}

{#- Maquettes : panneau avec un titre et une barre remplie (style : sa largeur) #}
{% macro barPanel(style, title) %}<div class="mk-panel"><p class="mk-h">{{ title }}</p><span class="mk-bar mk-bar-ink"><i style="{{ style }}"></i></span></div>{% endmacro %}
