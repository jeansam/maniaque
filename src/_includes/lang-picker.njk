<div class="picker picker-lang"><button type="button" class="lang picker-btn" aria-expanded="false" aria-controls="lang-menu" aria-label="{{ t.languageLabel }}{{ language.name }}">{{ language.short }}</button><div class="picker-menu" id="lang-menu">{% for code in langMenu %}{% set l = langs | find(code) %}<a href="{{ routes[p.key][code] }}" hreflang="{{ l.htmlLang }}" lang="{{ l.htmlLang }}"{% if code == lang %} aria-current="true"{% endif %}>{% include "flags/" + code + ".svg" %}{{ l.name }}</a>{% endfor %}</div></div>