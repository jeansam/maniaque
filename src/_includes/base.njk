{% import "components.njk" as c %}<!doctype html>
<html lang="{{ language.htmlLang }}" data-city="{{ city.id }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- Sans titre propre, une page prend son libellé du menu (À propos, Articles, Mentions légales) #}
{% set title = s.title or t.sections[p.key] or t[p.key] -%}
<title>{% if brandFirst %}Maniaque, {{ title }}{% else %}{{ title }}, Maniaque{% endif %}</title>
{% if variant == "legal" %}<meta name="robots" content="noindex">
{% else %}<meta name="description" content="{{ s.description }}">
{% endif %}{% if og %}<meta property="og:title" content="{{ s.ogTitle or (("Maniaque, " if brandFirst else "") + title) }}">
<meta property="og:description" content="{{ s.ogDescription or s.description }}">
{% endif %}{% if og == "article" %}<meta property="og:image" content="{{ p.url }}illustration.png">
<meta property="og:type" content="article">
{% endif %}{% if variant != "legal" %}<meta name="theme-color" content="#F6F8FA">
{% endif %}{% for l in langs %}<link rel="alternate" hreflang="{{ l.htmlLang }}" href="{{ routes[p.key][l.code] }}">
{% endfor %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
<script src="/city.js"></script>
</head>
{% if variant == "legal" -%}
<body>
<header class="bar">
  <div class="wrap bar-inner">
    <div class="brand">
      {% include "wordmark.njk" %}
    </div>
  </div>
</header>
<main class="{{ mainClass }}">{{ content }}</main>
<footer class="foot">
  <div class="wrap foot-inner">
    {% set small = true %}{% include "wordmark.njk" %}
    <span class="foot-links">
      <a href="{{ routes.home[lang] }}">{{ t.backHome }}</a>
{% for l in langs %}{% if l.code != lang %}      <a href="{{ routes.legal[l.code] }}" hreflang="{{ l.htmlLang }}" lang="{{ l.htmlLang }}" aria-label="{{ l.versionLabel }}">{{ l.short }}</a>
{% endif %}{% endfor %}    </span>
  </div>
</footer>
</body>
</html>
{% else -%}
<body{% if variant == "home" %} class="home-map"{% endif %}>

<a class="skip" href="#{{ t.mainId }}">{{ t.skip }}</a>

{% if variant == "home" -%}
<header class="bar bar-min">
  <div class="wrap bar-inner">
    {% include "wordmark.njk" %}
    {% include "lang-picker.njk" %}
  </div>
</header>
{%- else -%}
<header class="bar">
  <div class="wrap bar-inner">
    <div class="brand">
      {% include "wordmark.njk" %}
      <p class="tagline"><svg class="tagline-pin" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span>{{ t.tagline }} <span class="tagline-city"><span class="picker picker-city"><button type="button" class="picker-btn city-btn" aria-expanded="false" aria-controls="city-menu" aria-label="{{ t.chooseCity }}"><span data-city-name>{{ city.name[lang] }}</span></button><span class="picker-menu" id="city-menu">{% for c in cities | values %}<a href="{{ routes[p.key][c.lang] }}?ville={{ c.id }}" data-set-city="{{ c.id }}"{% if c.id == city.id %} aria-current="true"{% endif %}>{{ c.name[lang] }}</a>{% endfor %}</span></span>.</span></span></p>
    </div>
    {{ c.burger("menu-btn", "main-nav", t.openMenu) }}
    <nav class="bar-nav" id="main-nav" aria-label="{{ t.mainNav }}">
{% for key, a in t.offerSections %}      <a href="{{ routes.offer[lang] }}#{{ a.id }}">{{ a.label }}</a>
{% endfor %}      <div class="nav-more">
        <button class="more-btn" type="button" aria-expanded="false" aria-controls="more-menu" aria-label="{{ t.moreLinks }}">{{ t.more }}</button>
        <div class="more-menu" id="more-menu">
{% for key in ["usecaseIndex", "about", "articleIndex"] %}          <a href="{{ routes[key][lang] }}"{% if section == key %} aria-current="page"{% endif %}>{{ t.sections[key] }}</a>
{% endfor %}        </div>
      </div>
      {% include "lang-picker.njk" %}
      <a data-book class="btn btn-small" target="_blank" rel="noopener">{{ t.book }}</a>
    </nav>
  </div>
</header>
{%- endif %}

<main id="{{ t.mainId }}"{% if mainClass %} class="{{ mainClass }}"{% endif %}>{{ content }}</main>
{% if variant != "home" %}
{#- Sur mobile et tablette, le bouton d'audit reste à portée de pouce une fois l'en-tête passé (nav.js) #}
<div class="book-bar"><a data-book class="btn" target="_blank" rel="noopener" tabindex="-1">{{ t.bookFree }}</a></div>
{% endif %}
{% if variant == "home" -%}
<footer class="map-foot">
  <a href="{{ routes.legal[lang] }}">{{ t.legal }}</a>
</footer>
{%- else -%}
<footer class="foot">
  <div class="wrap foot-inner">
    {% set small = true %}{% include "wordmark.njk" %}
    <p>{{ t.footer }}</p>
    <a href="{{ routes.legal[lang] }}">{{ t.legal }}</a>
  </div>
</footer>
{%- endif %}

{% for src in scripts %}<script src="/{{ src }}" defer></script>
{% endfor %}</body>
</html>
{% endif -%}
