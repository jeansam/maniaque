{% import "components.njk" as c %}
            {{ c.sidebar("qt", s.brand, s.menu) }}
            <div class="qt-main">
              {{ c.screenHead("qt", s.titles, "mk-pill mk-warn", s.status) }}
              <div class="mk-panel">{% for mkH in s.panel %}<p class="{{ mkH.class }}">{{ mkH.label }}</p>{% endfor %}</div><p class="mk-h">{{ s.mainTitle }}</p><div class="mk-field">{% for item in s.fields %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields2 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields3 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields4 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields5 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields6 %}<span{% if item.mkPillMkWarn %} class="mk-pill mk-warn"{% endif %}>{{ item.label }}</span>{% endfor %}</div>
            </div><div class="mk-aside"><div class="mk-doc mk-doc-s"><p class="mk-doc-logo">{{ s.docLogo }}</p><p class="mk-doc-t">{{ s.docTitle }}</p><p>{{ s.docText }}</p><p class="mk-sub">{{ s.docSubtitle }}</p>{% for mkDocTxt in s.docTexts %}<i class="mk-doc-txt" style="{{ mkDocTxt.style }}"></i>{% endfor %}</div><span class="mk-btn">{{ s.asideButton }}</span></div>
          