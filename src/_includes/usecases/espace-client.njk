{% import "components.njk" as c %}
            {{ c.dcSide("qt-side", "qt-brand", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.dcHead2("qt-head", s.qtNums) }}
              <div class="mk-panel"><p class="mk-h">{{ s.mkPanelMkH }}</p><div class="mk-steps">{% for done in s.mkSteps %}<div class="{{ done.class }}"><i></i><span>{{ done.span }}</span></div>{% endfor %}</div></div><div class="mk-panel"><p class="mk-h">{{ s.mkPanelMkH2 }}</p>{{ c.dcTable("mk-table", "--tpl:1fr 1fr 1fr 1fr", s.mkTable) }}</div>
            </div><div class="mk-aside"><p class="mk-h">{{ s.mkAsideMkH }}</p>{% for mkItem in s.mkItems %}<div class="mk-item"><b>PDF</b><div><span>{{ mkItem.span }}</span><small>{{ mkItem.small }}</small></div></div>{% endfor %}<p class="mk-h mk-mt">{{ s.mkAsideMkH2 }}</p>{% for mkMsg in s.mkMsgs %}<div class="{{ mkMsg.class }}">{{ mkMsg.label }}</div>{% endfor %}</div>
          