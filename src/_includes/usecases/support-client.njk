{% import "components.njk" as c %}
            {{ c.dcSide("qt-side", "qt-brand", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.dcHead("qt-head", s.qtNums, "mk-pill mk-bad", s.qtHeadMkPill) }}
              <div class="mk-row"><div class="mk-inbox"><div class="mk-mail on"><b>{{ s.mkMailB }}</b>{% for item in s.items2 %}<span{% if item.mkPillMkBad %} class="mk-pill mk-bad"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-mail"><b>{{ s.mkMailB2 }}</b>{% for item in s.items3 %}<span{% if item.mkPillMkInfo %} class="mk-pill mk-info"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-mail"><b>{{ s.mkMailB3 }}</b>{% for item in s.items4 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-mail"><b>{{ s.mkMailB4 }}</b>{% for item in s.items5 %}<span{% if item.mkPillMkWarn %} class="mk-pill mk-warn"{% endif %}>{{ item.label }}</span>{% endfor %}</div></div><div class="mk-grow"><div class="mk-panel">{% for mkH in s.mkHs %}<p class="{{ mkH.class }}">{{ mkH.label }}</p>{% endfor %}<div class="mk-actions">{% for mkSub in s.mkActions %}<span class="{{ mkSub.class }}">{{ mkSub.label }}</span>{% endfor %}</div></div></div></div>
            </div>
          