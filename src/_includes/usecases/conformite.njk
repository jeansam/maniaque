{% import "components.njk" as c %}
            {{ c.sidebar("qt", s.brand, s.menu) }}
            <div class="qt-main">
              {{ c.screenHead("qt", s.titles, "mk-pill mk-bad", s.status) }}
              {{ c.kpis("mk-kpis", "mk-kpi", s.kpis) }}<div class="mk-table" style="--tpl:1fr repeat(4, 1fr)"><div class="mk-tr mk-th">{% for column in s.columns %}<span>{{ column }}</span>{% endfor %}</div>{% for person in s.staff %}<div class="mk-tr"><span><em class="mk-av" style="background:{{ person.color }}">{{ person.name[0] }}</em>{{ person.name }}</span>{% for status in person.status %}<span><span class="mk-pill mk-{{ status }}">{{ s.statuses[status] }}</span></span>{% endfor %}</div>{% endfor %}</div>
            </div><div class="mk-aside"><p class="mk-h">{{ s.asideTitle }}</p>{% for mkItem in s.items %}<div class="mk-item"><b>{{ mkItem.b }}</b><div><span>{{ mkItem.span }}</span><small>{{ mkItem.small }}</small></div></div>{% endfor %}<span class="mk-btn">{{ s.asideButton }}</span></div>
          