{% import "components.njk" as c %}
            {{ c.dcSide("qt-side", "qt-brand", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.dcHead("qt-head", s.qtNums, "mk-pill mk-ok", s.qtHeadMkPill) }}
              <div class="mk-table" style="--tpl:1.3fr repeat(5, .6fr) .7fr 1fr"><div class="mk-tr mk-th"><span>{{ s.employee }}</span>{% for day in t.weekdays %}<span>{{ day }}</span>{% endfor %}<span>Total</span><span></span></div>{% for person in s.timesheets %}<div class="mk-tr"><span><em class="mk-av" style="background:{{ person.color }}">{{ person.name[0] }}</em>{{ person.name }}</span>{% for h in person.hours %}<span>{% if h == none %}—{% else %}{{ h | number(lang) }}{{ s.hourUnit }}{% endif %}</span>{% endfor %}<span><b>{{ person.hours | sum | number(lang) }}{{ s.hourUnit }}</b></span><span><span class="mk-pill mk-{{ person.status }}">{{ s.statuses[person.status] }}</span></span></div>{% endfor %}</div>
            </div><div class="mk-aside"><p class="mk-h">{{ s.mkAsideMkH }}</p><div class="mk-phone"><p class="mk-ph-t">{{ s.mkPhoneMkPhT }}</p>{% for mkLine in s.mkLines %}<div class="mk-line"><span>{{ mkLine.span }}</span><b>{{ mkLine.b }}</b></div>{% endfor %}<span class="mk-btn">{{ s.mkPhoneMkBtn }}</span></div><p class="mk-h mk-mt">{{ s.mkAsideMkH2 }}</p>{% for mkLine in s.mkLines2 %}<div class="mk-line"><span>{{ mkLine.span }}</span><b>{{ mkLine.b }}</b></div>{% endfor %}</div>
          