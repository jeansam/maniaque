{% import "components.njk" as c %}
            {{ c.dcSide("qt-side", "qt-brand", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.dcHead("qt-head", s.qtNums, "qt-status", s.qtHeadQtStatus) }}
              <div class="qt-body">
                <div class="qt-cat"><p class="qt-search">{{ s.qtCatQtSearch }}</p><ul>{% for in in s.ins %}<li class="{{ in.class }}"><span>{{ in.span }}</span><b>{{ in.b }}</b></li>{% endfor %}</ul></div>
                <div class="qt-sheet">
                  <div class="qt-table">{% for qtTr in s.qtTable %}<div class="{{ qtTr.class }}">{% for item in qtTr.items %}<span>{{ item }}</span>{% endfor %}</div>{% endfor %}</div>
                  <div class="qt-foot">
                    <div class="qt-margin"><b>{{ s.qtMarginB }}</b><span>{{ s.qtMarginSpan }}</span></div>
                    <div class="qt-tot">{% for item in s.qtTot %}<div{% if item.qtTtc %} class=qt-ttc{% endif %}><span>{{ item.span }}</span><b>{{ item.b }}</b></div>{% endfor %}</div>
                  </div>
                  <div class="qt-actions">{% for qtRemind in s.qtActions %}<span class="{{ qtRemind.class }}">{{ qtRemind.label }}</span>{% endfor %}</div>
                </div>
              </div>
            </div>
            <div class="qt-pdf">
              {% for qtPdfLogo in s.qtPdfLogos %}{% if not loop.first %}
              {% endif %}<p class="{{ qtPdfLogo.class }}">{{ qtPdfLogo.label }}</p>{% endfor %}
              <div class="qt-pdf-lines">{% for item in s.qtPdfLines %}<div>{% for item2 in item.items %}<span>{{ item2 }}</span>{% endfor %}</div>{% endfor %}</div>
              <div class="qt-pdf-total"><span>{{ s.qtPdfTotalSpan }}</span><b>{{ s.qtPdfTotalB }}</b></div>
              {% for qtPdfValid in s.qtPdfValids %}{% if not loop.first %}
              {% endif %}<p class="{{ qtPdfValid.class }}">{{ qtPdfValid.label }}</p>{% endfor %}
            </div>
          