{% import "components.njk" as c %}
            {{ c.sidebar("qt", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.screenHead("qt", s.qtNums, "mk-pill mk-ok", s.qtHeadMkPill) }}
              {{ c.kpis("mk-kpis", "mk-kpi", s.kpis) }}<div class="mk-row"><div class="mk-panel mk-grow"><p class="mk-h">{{ s.mkPanelMkH }}</p><svg class="mk-chart" viewBox="0 0 600 120" preserveAspectRatio="none">{% for line in s.lines %}<line x1="0" x2="600" y1="{{ line.y1 }}" y2="{{ line.y2 }}" stroke="#E6E8EC" vector-effect="non-scaling-stroke"/>{% endfor %}<path d="M0.0 55.4 L54.5 48.0 L109.1 51.7 L163.6 44.2 L218.2 38.0 L272.7 41.7 L327.3 33.0 L381.8 35.5 L436.4 28.1 L490.9 21.9 L545.5 25.6 L600.0 15.7 L600 120 L0 120 Z" fill="#142850" opacity=".08"/><path d="M0.0 55.4 L54.5 48.0 L109.1 51.7 L163.6 44.2 L218.2 38.0 L272.7 41.7 L327.3 33.0 L381.8 35.5 L436.4 28.1 L490.9 21.9 L545.5 25.6 L600.0 15.7" fill="none" stroke="#142850" stroke-width="2" vector-effect="non-scaling-stroke"/></svg></div><div class="mk-panel"><p class="mk-h">{{ s.mkPanelMkH2 }}</p><div class="mk-bars"><svg class="mk-chart" viewBox="0 0 300 110" preserveAspectRatio="none">{% for rect in s.mkChart %}<rect x="{{ rect.x }}" y="{{ rect.y }}" width="41.2" height="{{ rect.height }}" rx="2" fill="{{ rect.fill }}" opacity="{{ rect.opacity }}"/>{% endfor %}</svg><div class="mk-bars-l" style="--n:4">{% for item in s.mkBarsL %}<span>{{ item }}</span>{% endfor %}</div></div></div></div>
            </div>
          