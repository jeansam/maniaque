{% import "components.njk" as c %}
            {{ c.sidebar("qt", s.qtSideQtBrand, s.items) }}
            <div class="qt-main">
              {{ c.screenHead("qt", s.qtNums, "mk-pill mk-warn", s.qtHeadMkPill) }}
              {{ c.barPanel("width:66%", s.mkPanelMkH) }}<div class="mk-field">{% for item in s.mkField %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.mkField2 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.mkField3 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.mkField4 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.mkField5 %}<span{% if item.mkPillMkWarn %} class="mk-pill mk-warn"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.mkField6 %}<span{% if item.mkPillMkInfo %} class="mk-pill mk-info"{% endif %}>{{ item.label }}</span>{% endfor %}</div>
