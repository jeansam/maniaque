{% import "components.njk" as c %}
            {{ c.sidebar("qt", s.brand, s.menu) }}
            <div class="qt-main">
              {{ c.screenHead("qt", s.titles, "mk-pill mk-warn", s.status) }}
              {{ c.barPanel("width:66%", s.panelTitle) }}<div class="mk-field">{% for item in s.fields %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields2 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields3 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields4 %}<span{% if item.mkPillMkOk %} class="mk-pill mk-ok"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields5 %}<span{% if item.mkPillMkWarn %} class="mk-pill mk-warn"{% endif %}>{{ item.label }}</span>{% endfor %}</div><div class="mk-field">{% for item in s.fields6 %}<span{% if item.mkPillMkInfo %} class="mk-pill mk-info"{% endif %}>{{ item.label }}</span>{% endfor %}</div>
