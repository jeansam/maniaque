{% import "components.njk" as c %}<div class="dc dc-green dc-phone" style="--ac:#C5F04A;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain">{% for dcPh in m.titles %}<p class="{{ dcPh.class }}">{{ dcPh.label }}</p>{% endfor %}<div class="dc-clock">{{ c.donut(78, 163.4, "07:58") }}</div><p class="dc-ok">{{ m.status }}</p>{{ c.kpis("dc-mk", "dc-kpi", m.kpis) }}</div><nav class="dc-tabbar">{% for item in m.tabs %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div>