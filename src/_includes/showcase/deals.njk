{% import "components.njk" as c %}<div class="dc dc-light dc-phone" style="--ac:#7C5CFC;--ac2:#22A06B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ m.title }}</p>{% for dcLi in m.list %}<div class="dc-li"><em>{{ dcLi.em }}</em><div><span>{{ dcLi.span }}</span><small>{{ dcLi.small }}</small></div><span class="dc-pill dc-info">{{ dcLi.dcPill }}</span></div>{% endfor %}</div><nav class="dc-tabbar">{% for item in m.tabs %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div>