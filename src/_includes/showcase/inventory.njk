{% import "components.njk" as c %}<div class="dc dc-dark " style="--ac:#2FBF71;--ac2:#F25C54">{{ c.sidebar("dc", "Stockly", m.menu, true) }}<div class="dc-main">{{ c.screenHead("dc", m.titles) }}{{ c.kpis("dc-kpis dc-k3", "dc-kpi", m.kpis) }}<div class="dc-row"><div class="dc-panel dc-grow"><p class="dc-cap">{{ m.caption }}</p><svg class="dc-chart" viewBox="0 0 300 {{ 70 }}" preserveAspectRatio="none">{% for bar in m.bars %}<rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ 12.4 }}" height="{{ bar.height }}" rx="1.5" fill="{{ bar.fill }}"/>{% endfor %}</svg></div><div class="dc-panel dc-center"><p class="dc-cap">{{ m.caption2 }}</p>{{ c.donut(64, 153.6, m.gauge) }}</div></div></div></div>