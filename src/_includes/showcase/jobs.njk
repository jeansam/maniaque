{% import "components.njk" as c %}<div class="dc dc-light dc-phone" style="--ac:#5B8DEF;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ m.title }}</p>{% for dcLi in m.list %}{{ c.listItem(dcLi.class, dcLi.b, dcLi.span, dcLi.small) }}{% endfor %}<span class="dc-cta">{{ m.action }}</span></div><nav class="dc-tabbar">{% for item in m.tabs %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div>