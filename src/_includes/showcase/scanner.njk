{% import "components.njk" as c %}<div class="dc dc-dark dc-phone" style="--ac:#2FBF71;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ m.title }}</p><div class="dc-scan"><i></i></div>{% for dcRef in m.lines %}<p class="{{ dcRef.class }}">{{ dcRef.label }}</p>{% endfor %}{{ c.kpis("dc-mk", "dc-kpi", m.kpis) }}<span class="dc-cta">{{ m.action }}</span></div><nav class="dc-tabbar">{% for item in m.tabs %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div>