{% import "components.njk" as c %}<div class="dc dc-light dc-wide" style="--ac:#F07B3F;--ac2:#142850"><div class="dc-main">{{ c.screenHead("dc", m.titles) }}<div class="dc-row"><div class="dc-panel dc-grow">{% for row in m.progress %}<div class="dc-prog"><span>{{ row.span }}</span><div><i style="{{ row.iStyle }}"></i></div><b>{{ row.b }}</b></div>{% endfor %}</div><div class="dc-panel dc-center"><p class="dc-cap">{{ m.caption }}</p>{{ c.donut(64, 132.3, m.gauge) }}</div></div><div class="dc-panel"><p class="dc-cap">{{ m.caption2 }}</p><svg class="dc-chart" viewBox="0 0 300 {{ 40 }}" preserveAspectRatio="none">{% for bar in m.bars %}<rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ 15.5 }}" height="{{ bar.height }}" rx="1.5" fill="{{ "var(--ac)" or bar.fill }}"/>{% endfor %}</svg></div></div></div>