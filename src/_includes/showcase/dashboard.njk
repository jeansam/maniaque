{% import "components.njk" as c %}<div class="dc dc-dark dc-phone" style="--ac:#5B8DEF;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ m.title }}</p><div class="dc-hero"><span>{{ m.heroLabel }}</span><b>{{ m.heroValue }}</b><i class="up">{{ m.heroTrend }}</i></div><svg class="dc-chart" viewBox="0 0 120 44" preserveAspectRatio="none">{% for dcGl in m.gridLines %}<line x1="0" x2="120" y1="{{ dcGl.y1 }}" y2="{{ dcGl.y2 }}" class="dc-gl"/>{% endfor %}<path d="M0.0 30.2 L10.9 26.1 L21.8 28.8 L32.7 23.3 L43.6 24.7 L54.5 19.2 L65.5 20.6 L76.4 15.0 L87.3 16.4 L98.2 10.9 L109.1 8.1 L120.0 4.0 L120 44 L0 44 Z" fill="var(--ac)" opacity=".16"/><path d="M0.0 30.2 L10.9 26.1 L21.8 28.8 L32.7 23.3 L43.6 24.7 L54.5 19.2 L65.5 20.6 L76.4 15.0 L87.3 16.4 L98.2 10.9 L109.1 8.1 L120.0 4.0" fill="none" stroke="var(--ac)" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg>{{ c.kpis("dc-mk", "dc-kpi", m.kpis) }}</div><nav class="dc-tabbar">{% for item in m.tabs %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div>