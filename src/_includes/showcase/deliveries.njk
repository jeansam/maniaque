{% import "components.njk" as c %}<div class="dc dc-green dc-wide" style="--ac:#C5F04A;--ac2:#F2B84B"><div class="dc-main">{{ c.screenHead("dc", m.titles) }}{{ c.kpis("dc-kpis dc-k3", "dc-kpi", m.kpis) }}<div class="dc-row"><div class="dc-map"><svg viewBox="0 0 100 100" preserveAspectRatio="none">{% for path in m.routes %}<path d="{{ path.d }}" fill="none" stroke="{{ path.stroke }}" stroke-width="1" stroke-dasharray="3 2" vector-effect="non-scaling-stroke"/>{% endfor %}</svg>{% for item in m.menu %}<i style="{{ item.style }}"></i>{% endfor %}</div><div class="dc-panel dc-grow">{% for row in m.progress %}<div class="dc-prog"><span>{{ row.span }}</span><div><i style="{{ row.iStyle }}"></i></div><b>{{ row.b }}</b></div>{% endfor %}</div></div></div></div>