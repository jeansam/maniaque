---
pagination: { data: pages.offer, size: 1, alias: p }
brandFirst: true
og: true
scripts: [script.js, nav.js]
---
{% import "components.njk" as c %}

  <section class="hero grid-paper">
    <div class="wrap">
      <div class="hero-head">
        <h1 class="hero-title">
          <span class="line">{{ s.heroLine1 }}</span>
          <span class="line"><span class="target" id="target">man<span class="ia">ia</span>que</span>{% if s.meaning %}<a class="star" href="#meaning" aria-label="{{ s.meaningLabel }}">*</a>{% endif %}</span>
          <span class="line">{{ s.heroLine3 }}</span>
        </h1>
        <div class="note" aria-hidden="true">
          <p class="note-ask">{{ s.noteAsk }}</p>
          <p class="note-next">{{ s.noteNext }}</p>
        </div>
      </div>
{% if s.meaning %}      <p class="meaning" id="meaning"><span class="star-ref" aria-hidden="true">*</span>{{ s.meaning }}</p>
{% endif %}      <div class="hero-foot">
        <p class="lede">{{ s.lede }}</p>
        <div class="hero-cta">
          <div class="hero-actions">
            <a data-book class="btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
            <a class="link" href="#{{ t.offerSections.pricing.id }}">{{ s.seePricing }}</a>
          </div>
          <a class="who" href="{{ routes.about[lang] }}"><img data-person-photo src="{{ city.person.photo }}" width="32" height="32" alt=""><span><span data-person-name>{{ city.person.name }}</span> {{ s.answers }}</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase" role="img" aria-label="{{ s.showcaseAriaLabel }}">
    <div class="showcase-row"><div class="showcase-track">{% set showcase1 %}<div class="dc dc-dark " style="--ac:#5B8DEF;--ac2:#F2B84B">{{ c.sidebar("dc", "Atlas", s.items, true) }}<div class="dc-main">{{ c.screenHead("dc", s.dcTitles, "dc-btn", s.dcHeadDcBtn) }}<div class="dc-kpis">{% for dcKpi in s.dcKpis %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b><i class="up">{{ dcKpi.up }}</i></div>{% endfor %}</div><div class="dc-panel"><p class="dc-cap">{{ s.dcPanelDcCap }}</p><svg class="dc-chart" viewBox="0 0 300 70" preserveAspectRatio="none">{% for dcGl in s.dcGls %}<line x1="0" x2="300" y1="{{ dcGl.y1 }}" y2="{{ dcGl.y2 }}" class="dc-gl"/>{% endfor %}<path d="M0.0 50.5 L10.3 47.9 L20.7 49.9 L31.0 45.3 L41.4 42.7 L51.7 44.0 L62.1 40.8 L72.4 42.1 L82.8 37.5 L93.1 38.8 L103.4 34.3 L113.8 35.6 L124.1 32.3 L134.5 29.7 L144.8 31.7 L155.2 28.4 L165.5 24.5 L175.9 27.1 L186.2 23.2 L196.6 21.3 L206.9 23.9 L217.2 19.4 L227.6 16.8 L237.9 18.7 L248.3 14.8 L258.6 12.9 L269.0 15.5 L279.3 11.6 L289.7 9.0 L300.0 6.4 L300 70 L0 70 Z" fill="var(--ac)" opacity=".16"/><path d="M0.0 50.5 L10.3 47.9 L20.7 49.9 L31.0 45.3 L41.4 42.7 L51.7 44.0 L62.1 40.8 L72.4 42.1 L82.8 37.5 L93.1 38.8 L103.4 34.3 L113.8 35.6 L124.1 32.3 L134.5 29.7 L144.8 31.7 L155.2 28.4 L165.5 24.5 L175.9 27.1 L186.2 23.2 L196.6 21.3 L206.9 23.9 L217.2 19.4 L227.6 16.8 L237.9 18.7 L248.3 14.8 L258.6 12.9 L269.0 15.5 L279.3 11.6 L289.7 9.0 L300.0 6.4" fill="none" stroke="var(--ac)" stroke-width="1.6" vector-effect="non-scaling-stroke"/><path d="M0.0 51.8 L10.3 50.5 L20.7 50.5 L31.0 48.6 L41.4 47.3 L51.7 46.6 L62.1 45.3 L72.4 44.7 L82.8 43.4 L93.1 42.1 L103.4 41.4 L113.8 40.1 L124.1 38.8 L134.5 37.5 L144.8 36.9 L155.2 35.6 L165.5 34.3 L175.9 33.6 L186.2 32.3 L196.6 31.0 L206.9 30.4 L217.2 29.1 L227.6 27.8 L237.9 27.1 L248.3 25.8 L258.6 24.5 L269.0 23.9 L279.3 22.6 L289.7 21.3 L300.0 20.0" fill="none" stroke="var(--ac2)" stroke-width="1.4" stroke-dasharray="4 3" vector-effect="non-scaling-stroke"/></svg></div></div></div><div class="dc dc-light dc-phone" style="--ac:#5B8DEF;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ s.dcPmainDcPh }}</p>{% for dcLi in s.dcLis %}{{ c.listItem(dcLi.class, dcLi.b, dcLi.span, dcLi.small) }}{% endfor %}<span class="dc-cta">{{ s.dcPmainDcCta }}</span></div><nav class="dc-tabbar">{% for item in s.dcTabbar %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-light dc-wide" style="--ac:#7C5CFC;--ac2:#22A06B"><div class="dc-main">{{ c.screenHead("dc", s.dcTitles2, "dc-btn", s.dcHeadDcBtn2) }}<div class="dc-kanban">{% for dcCol in s.dcKanban %}<div class="dc-col"><p class="dc-colh">{{ dcCol.dcColh }}</p>{% for dcDeal in dcCol.dcDeals %}<div class="dc-deal"><b>{{ dcDeal.b }}</b><span>{{ dcDeal.span }}</span><i></i></div>{% endfor %}</div>{% endfor %}</div></div></div><div class="dc dc-dark dc-phone" style="--ac:#2FBF71;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ s.dcPmainDcPh2 }}</p><div class="dc-scan"><i></i></div>{% for dcRef in s.dcRefs %}<p class="{{ dcRef.class }}">{{ dcRef.label }}</p>{% endfor %}<div class="dc-mk">{% for dcKpi in s.dcMk %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div><span class="dc-cta">{{ s.dcPmainDcCta2 }}</span></div><nav class="dc-tabbar">{% for item in s.dcTabbar2 %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-light dc-purple" style="--ac:#7C5CFC;--ac2:#22A06B">{{ c.sidebar("dc", s.dcSideDcBrand, s.items2) }}<div class="dc-main">{{ c.screenHead("dc", s.dcTitles3, "dc-btn", s.dcHeadDcBtn3) }}{{ c.table("dc-table", "--cols:4", s.dcTable) }}</div></div><div class="dc dc-green dc-wide" style="--ac:#C5F04A;--ac2:#F2B84B"><div class="dc-main">{{ c.screenHead("dc", s.dcTitles4) }}<div class="dc-kpis dc-k3">{% for dcKpi in s.dcKpis2 %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div><div class="dc-row"><div class="dc-map"><svg viewBox="0 0 100 100" preserveAspectRatio="none">{% for path in s.svg %}<path d="{{ path.d }}" fill="none" stroke="{{ path.stroke }}" stroke-width="1" stroke-dasharray="3 2" vector-effect="non-scaling-stroke"/>{% endfor %}</svg>{% for item in s.items3 %}<i style="{{ item.style }}"></i>{% endfor %}</div>{{ c.progress(s.dcPanel) }}</div></div></div><div class="dc dc-light dc-phone" style="--ac:#F07B3F;--ac2:#142850"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ s.dcPmainDcPh3 }}</p><div class="dc-photo"></div>{% for dcName in s.dcNames %}<p class="{{ dcName.class }}">{{ dcName.label }}</p>{% endfor %}<span class="dc-cta">{{ s.dcPmainDcCta3 }}</span></div><nav class="dc-tabbar">{% for item in s.dcTabbar3 %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-dark " style="--ac:#E5677D;--ac2:#F2B84B">{{ c.sidebar("dc", "Helpo", s.items4, true) }}<div class="dc-main">{{ c.screenHead("dc", s.dcTitles5) }}<div class="dc-kpis dc-k3">{% for dcKpi in s.dcKpis3 %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div>{{ c.table("dc-table", "--cols:4", s.dcTable2) }}</div></div>{% endset %}{{ showcase1 }}<div class="showcase-dup" aria-hidden="true">{{ showcase1 }}</div></div></div>
    <div class="showcase-row showcase-rev"><div class="showcase-track">{% set showcase2 %}<div class="dc dc-light dc-wide" style="--ac:#5B8DEF;--ac2:#F2B84B"><div class="dc-main">{{ c.screenHead("dc", s.dcTitles11) }}<div class="dc-plan"><span></span><div class="dc-days">{% for item in t.weekdays %}<span>{{ item }}</span>{% endfor %}</div><span class="dc-who"><em style="background:#5B8DEF"></em>Julien</span>{{ c.lane("dc-lane", s.dcLane, "dc-job") }}<span class="dc-who"><em style="background:#F2B84B"></em>Sarah</span><div class="dc-lane"><span class="dc-job" style="--s:1;--l:3;--c:#F2B84B">{{ s.dcLaneDcJob3 }}</span></div><span class="dc-who"><em style="background:#E5677D"></em>Karim</span>{{ c.lane("dc-lane", s.dcLane2, "dc-job") }}<span class="dc-who"><em style="background:#2FBF71"></em>Léa</span>{{ c.lane("dc-lane", s.dcLane3, "dc-job") }}</div></div></div><div class="dc dc-dark dc-phone" style="--ac:#5B8DEF;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ s.dcPmainDcPh7 }}</p><div class="dc-hero"><span>{{ s.dcHeroSpan }}</span><b>{{ s.dcHeroB }}</b><i class="up">{{ s.dcHeroUp }}</i></div><svg class="dc-chart" viewBox="0 0 120 44" preserveAspectRatio="none">{% for dcGl in s.dcGls3 %}<line x1="0" x2="120" y1="{{ dcGl.y1 }}" y2="{{ dcGl.y2 }}" class="dc-gl"/>{% endfor %}<path d="M0.0 30.2 L10.9 26.1 L21.8 28.8 L32.7 23.3 L43.6 24.7 L54.5 19.2 L65.5 20.6 L76.4 15.0 L87.3 16.4 L98.2 10.9 L109.1 8.1 L120.0 4.0 L120 44 L0 44 Z" fill="var(--ac)" opacity=".16"/><path d="M0.0 30.2 L10.9 26.1 L21.8 28.8 L32.7 23.3 L43.6 24.7 L54.5 19.2 L65.5 20.6 L76.4 15.0 L87.3 16.4 L98.2 10.9 L109.1 8.1 L120.0 4.0" fill="none" stroke="var(--ac)" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg><div class="dc-mk">{% for dcKpi in s.dcMk3 %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div></div><nav class="dc-tabbar">{% for item in s.dcTabbar7 %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-dark " style="--ac:#2FBF71;--ac2:#F25C54">{{ c.sidebar("dc", "Stockly", s.items9, true) }}<div class="dc-main">{{ c.screenHead("dc", s.dcTitles12) }}<div class="dc-kpis dc-k3"><div class="dc-kpi"><span>{{ s.dcKpiSpan27 }}</span><b>12</b><i class="up">−4</i></div><div class="dc-kpi"><span>{{ s.dcKpiSpan28 }}</span><b>37</b><i class="down">+6</i></div><div class="dc-kpi"><span>{{ s.dcKpiSpan29 }}</span><b>{{ s.dcKpiB16 }}</b></div></div><div class="dc-row"><div class="dc-panel dc-grow"><p class="dc-cap">{{ s.dcPanelDcCap3 }}</p><svg class="dc-chart" viewBox="0 0 300 70" preserveAspectRatio="none">{% for rect in s.dcChart %}<rect x="{{ rect.x }}" y="{{ rect.y }}" width="12.4" height="{{ rect.height }}" rx="1.5" fill="{{ rect.fill }}"/>{% endfor %}</svg></div><div class="dc-panel dc-center"><p class="dc-cap">{{ s.dcPanelDcCap4 }}</p><div class="dc-donut" style="width:64px;height:64px"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="none" stroke="var(--line)" stroke-width="7"/><circle cx="32" cy="32" r="26" fill="none" stroke="var(--ac)" stroke-width="7" stroke-linecap="round" stroke-dasharray="153.6 163.4" transform="rotate(-90 32 32)"/></svg><b>{{ s.dcDonutB }}</b></div></div></div></div></div><div class="dc dc-light dc-wide" style="--ac:#7C5CFC;--ac2:#F2B84B"><div class="dc-main">{{ c.screenHead("dc", s.dcTitles13) }}<div class="dc-org"><div class="dc-node dc-top"><em style="background:#142850">M</em><b>Marc</b><span>{{ s.dcNodeSpan }}</span></div><div class="dc-branch"></div><div class="dc-nodes">{% for dcNode in s.dcNodes %}<div class="dc-node"><em style="{{ dcNode.emStyle }}">{{ dcNode.em }}</em><b>{{ dcNode.b }}</b><span>{{ dcNode.span }}</span></div>{% endfor %}</div></div></div></div><div class="dc dc-light dc-phone" style="--ac:#7C5CFC;--ac2:#22A06B"><span class="dc-notch"></span><div class="dc-pmain"><p class="dc-ph">{{ s.dcPmainDcPh8 }}</p>{% for dcLi in s.dcLis3 %}<div class="dc-li"><em>{{ dcLi.em }}</em><div><span>{{ dcLi.span }}</span><small>{{ dcLi.small }}</small></div><span class="dc-pill dc-info">{{ dcLi.dcPill }}</span></div>{% endfor %}</div><nav class="dc-tabbar">{% for item in s.dcTabbar8 %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-dark " style="--ac:#F2B84B;--ac2:#5B8DEF">{{ c.sidebar("dc", s.dcSideDcBrand3, s.items10) }}<div class="dc-main">{{ c.screenHead("dc", s.dcTitles14) }}<div class="dc-row"><div class="dc-cal"><span class="dc-dh">{{ s.dcCalDcDh }}</span><span class="dc-dh">{{ s.dcCalDcDh2 }}</span><span class="dc-dh">{{ s.dcCalDcDh3 }}</span><span class="dc-dh">{{ s.dcCalDcDh4 }}</span><span class="dc-dh">{{ s.dcCalDcDh5 }}</span><span class="dc-dh">S</span><span class="dc-dh">{{ s.dcCalDcDh6 }}</span><span></span><span></span><span></span><span class="">1</span><span class="">2</span><span class="b">3</span><span class="b">4</span><span class="b">5</span><span class="">6</span><span class="">7</span><span class="">8</span><span class="">9</span><span class="b">10</span><span class="b">11</span><span class="b">12</span><span class="b">13</span><span class="">14</span><span class="">15</span><span class="">16</span><span class="b">17</span><span class="b">18</span><span class="b">19</span><span class="b">20</span><span class="">21</span><span class="">22</span><span class=" t">23</span><span class="b">24</span><span class="b">25</span><span class="b">26</span><span class="b">27</span><span class="">28</span><span class="">29</span><span class="">30</span><span class="">31</span></div><div class="dc-col2">{% for dcKpi in s.dcCol2 %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div></div></div></div><div class="dc dc-green dc-phone" style="--ac:#C5F04A;--ac2:#F2B84B"><span class="dc-notch"></span><div class="dc-pmain">{% for dcPh in s.dcPhs %}<p class="{{ dcPh.class }}">{{ dcPh.label }}</p>{% endfor %}<div class="dc-clock"><div class="dc-donut" style="width:78px;height:78px"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="none" stroke="var(--line)" stroke-width="7"/><circle cx="32" cy="32" r="26" fill="none" stroke="var(--ac)" stroke-width="7" stroke-linecap="round" stroke-dasharray="163.4 163.4" transform="rotate(-90 32 32)"/></svg><b>07:58</b></div></div><p class="dc-ok">{{ s.dcPmainDcOk }}</p><div class="dc-mk">{% for dcKpi in s.dcMk4 %}<div class="dc-kpi"><span>{{ dcKpi.span }}</span><b>{{ dcKpi.b }}</b></div>{% endfor %}</div></div><nav class="dc-tabbar">{% for item in s.dcTabbar9 %}<i{% if item.on %} class="on"{% endif %}></i>{% endfor %}</nav></div><div class="dc dc-light dc-wide" style="--ac:#F07B3F;--ac2:#142850"><div class="dc-main">{{ c.screenHead("dc", s.dcTitles15) }}<div class="dc-row">{{ c.progress(s.dcPanel3) }}<div class="dc-panel dc-center"><p class="dc-cap">{{ s.dcPanelDcCap5 }}</p><div class="dc-donut" style="width:64px;height:64px"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="none" stroke="var(--line)" stroke-width="7"/><circle cx="32" cy="32" r="26" fill="none" stroke="var(--ac)" stroke-width="7" stroke-linecap="round" stroke-dasharray="132.3 163.4" transform="rotate(-90 32 32)"/></svg><b>{{ s.dcDonutB2 }}</b></div></div></div><div class="dc-panel"><p class="dc-cap">{{ s.dcPanelDcCap6 }}</p><svg class="dc-chart" viewBox="0 0 300 40" preserveAspectRatio="none">{% for rect in s.dcChart2 %}<rect x="{{ rect.x }}" y="{{ rect.y }}" width="15.5" height="{{ rect.height }}" rx="1.5" fill="var(--ac)"/>{% endfor %}</svg></div></div></div>{% endset %}{{ showcase2 }}<div class="showcase-dup" aria-hidden="true">{{ showcase2 }}</div></div></div>
  </section>

  <section class="section section-alt" id="{{ t.offerSections.howItWorks.id }}" aria-labelledby="t-etapes">
    <div class="wrap">
      <h2 id="t-etapes">{{ s.howItWorksSteps }}</h2>
      <ol class="steps">{% for step in s.steps %}
        <li>
          <h3><button type="button" class="step-toggle" aria-expanded="false" aria-controls="step-desc-{{ loop.index }}">{{ step.title }}</button></h3>
          <p class="step-meta">{{ step.meta }}</p>
          <p class="step-desc" id="step-desc-{{ loop.index }}">{{ step.text }}</p>
{% if loop.first %}          <a data-book class="btn btn-small step-btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
{% endif %}        </li>{% endfor %}
      </ol>
    </div>
  </section>

  <section class="section" id="{{ t.offerSections.pricing.id }}" aria-labelledby="t-tarifs">
    <div class="wrap">
      <h2 id="t-tarifs">{{ s.pricing }}</h2>
      <p class="section-lede">{{ s.pricingSectionLede }}</p>
      <div class="quote">
        <table class="quote-table">
          <caption class="visually-hidden">{{ s.quoteTableVisuallyHidden }}</caption>
          <thead>
            <tr>
              <td></td>
              {% for item in s.items13 %}{% if not loop.first %}
              {% endif %}<th scope="col">{{ item }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for item in s.tbody %}{% if not loop.first %}
            {% endif %}<tr><th scope="row">{{ item.th }}</th>{% for item2 in item.items %}<td{% if item2.num %} class="num"{% endif %}>{{ item2.label }}</td>{% endfor %}</tr>{% endfor %}
          </tbody>
        </table>
        <div class="quote-notes">{% for note in s.notes %}
          <p><button type="button" class="note-toggle" aria-expanded="false" aria-controls="note-{{ note.id }}">{{ note.title }}</button><span class="note-sep">{{ note.sep or t.colon }}</span><span class="note-body" id="note-{{ note.id }}">{{ note.text }}</span></p>{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ s.commitmentsId }}" aria-labelledby="t-engagements">
    <div class="wrap split split-wide">
      <div class="split-text">
        <h2 id="t-engagements">{{ s.splitTextCommitments }}</h2>
        <p>{{ s.splitTextP }}</p>
      </div>
      <div>
        <ul class="promises">
          {% for item in s.promises %}{% if not loop.first %}
          {% endif %}<li>{{ item }}</li>{% endfor %}
        </ul>
        <div class="guarantee">
          {% for item in s.guarantee %}{% if not loop.first %}
          {% endif %}<p{% if item.guaranteeTitle %} class="guarantee-title"{% endif %}>{{ item.label }}</p>{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="{{ s.safeguardsId }}" aria-labelledby="t-garanties">
    <div class="wrap">
      <h2 id="t-garanties">{{ s.safeguards }}</h2>
      <p class="section-lede">{{ s.safeguardsSectionLede }}</p>
      <div class="assurances">
        {% for item in s.assurances %}{% if not loop.first %}
        {% endif %}<div>
          <svg class="icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{{ item.icon }}</svg>
          <h3>{{ item.h3 }}</h3>
          <p>{{ item.p }}</p>
        </div>{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ t.offerSections.faq.id }}" aria-labelledby="t-faq">
    <div class="wrap faq-wrap">
      <div class="faq-head">
        <h2 id="t-faq">{{ s.faqHeadFaq }}</h2>
        <div class="roles" role="group" aria-labelledby="faq-who">
          <p class="roles-label" id="faq-who">{{ s.faqWho }}</p>
          <div class="roles-list">{% for role in s.rolesList %}<button type="button" class="role" data-role="{{ role.dataRole }}" aria-pressed="false">{{ role.label }}</button>{% endfor %}</div>
        </div>
      </div>
      <div class="faq">{% for entry in s.faq %}
        <details data-roles="{{ entry.roles }}">
          <summary>{{ entry.q }}</summary>
{% if entry.byCity %}{#- une réponse par ville : seule celle de la ville choisie s'affiche #}{% for city, answer in entry.byCity %}          <p data-city-only="{{ city }}">{{ answer }}</p>
{% endfor %}{% else %}          <p>{{ entry.a }}</p>
{% endif %}        </details>{% endfor %}
      </div>
    </div>
  </section>

  {{ c.cta(t.cta.title, t.cta.text, t.cta.button, "audit", s.auditCtaAlt) }}

