---
pagination: { data: pages.offer, size: 1, alias: p }
brandFirst: true
og: true
scripts: [script.js, nav.js]
---
{% import "components.njk" as c %}

  <section class="hero grid-paper">
    <div class="wrap">
      <h1 class="hero-title">
        <span class="line">{{ s.heroLine1 }} <span class="hero-word">{{ s.heroWord }}</span>{% if s.meaning %}<a class="star" href="#meaning" aria-label="{{ s.meaningLabel }}">*</a>{% endif %}</span>
        <span class="line">{{ s.heroLine3 }}</span>
      </h1>
{% if s.meaning %}      <p class="meaning" id="meaning"><span class="star-ref" aria-hidden="true">*</span>{{ s.meaning }}</p>
{% endif %}      <div class="hero-foot">
        <p class="lede">{{ s.lede }}</p>
        <div class="hero-cta">
          <div class="hero-actions">
            <a data-book class="btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
            <a class="link" href="#{{ t.offerSections.pricing.id }}">{{ s.seePricing }}</a>
          </div>
          <a class="who" href="{{ routes.about[lang] }}"><img data-person-photo src="{{ city.person.photo }}" width="32" height="32" alt=""><span><span data-person-name>{{ city.person.name }}</span> {{ t.answers }}</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase" role="img" aria-label="{{ s.showcaseLabel }}">
{#- Deux bandes de maquettes d'écran (src/_includes/showcase/) qui défilent sans fin : chacune est répétée, la copie cachée aux lecteurs d'écran -#}
{% for row in [["sales", "jobs", "pipeline", "scanner", "invoices", "deliveries", "booking", "support"], ["schedule", "dashboard", "inventory", "team", "deals", "bookings", "timeClock", "workshop"]] %}
    <div class="showcase-row{% if not loop.first %} showcase-rev{% endif %}"><div class="showcase-track">{% set mockups %}{% for id in row %}{% set m = s.showcase[id] %}{% include "showcase/" + id + ".njk" %}{% endfor %}{% endset %}{{ mockups }}<div class="showcase-dup" aria-hidden="true">{{ mockups }}</div></div></div>
{%- endfor %}
  </section>

  <section class="section section-alt" id="{{ t.offerSections.howItWorks.id }}" aria-labelledby="t-etapes">
    <div class="wrap">
      <h2 id="t-etapes">{{ s.stepsTitle }}</h2>
      <ol class="steps">{% for step in s.steps %}
{#- Sur mobile, la première étape est ouverte d'emblée : on voit qu'il y a du texte à déplier #}
        <li{% if loop.first %} class="is-open"{% endif %}>
          <h3><button type="button" class="step-toggle" aria-expanded="{{ "true" if loop.first else "false" }}" aria-controls="step-desc-{{ loop.index }}">{{ step.title }}</button></h3>
          <p class="step-meta">{{ step.meta }}</p>
          <p class="step-desc" id="step-desc-{{ loop.index }}">{{ step.text }}</p>
{% if loop.first %}          <a data-book class="btn btn-small step-btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
{% endif %}        </li>{% endfor %}
      </ol>
    </div>
  </section>

  <section class="section" id="{{ t.offerSections.pricing.id }}" aria-labelledby="t-tarifs">
    <div class="wrap">
      <h2 id="t-tarifs">{{ s.pricingTitle }}</h2>
      <p class="section-lede">{{ s.pricingLede }}</p>
{#- Monnaie au choix, pour les villes qui en proposent plusieurs (currencies dans cities.js) ; affiché par city.js #}
{% for c in cities | values %}{% if c.currencies %}      <div class="currency" data-currencies data-city-only="{{ c.id }}" role="group" aria-labelledby="currency-label-{{ c.id }}" hidden>
        <span class="currency-label" id="currency-label-{{ c.id }}">{{ s.currencyLabel }}</span>{% for m in c.currencies %}
        <button type="button" data-currency="{{ m.code }}" aria-pressed="{{ "true" if m.code == c.currency else "false" }}">{{ m.label }} {{ m.code }}</button>{% endfor %}
      </div>
{% endif %}{% endfor %}      <div class="quote">
{#- Les deux montants fixes : la première version, puis l'abonnement de base #}
        <div class="price-cards">
          <div class="price-card">
            <h3 class="price-name">{{ s.first.title }}</h3>
            <p class="price-amount">{{ s.first.price }}</p>
            <p class="price-when">{{ s.first.when }}</p>
            <p class="price-text">{{ s.first.text }}</p>
          </div>
          <div class="price-card">
            <h3 class="price-name">{{ s.base.title }}</h3>
            <p class="price-amount">{{ s.base.price }}</p>
            <p class="price-when">{{ s.base.when }}</p>
            <ul class="price-includes">{% for item in s.base.includes %}
              <li>{{ item }}</li>{% endfor %}
            </ul>
          </div>
        </div>
{#- Demandes fonctionnelles : un curseur choisit entre l'unité et les paliers du forfait (script.js).
    Sans JavaScript, le curseur est masqué et tous les paliers s'affichent, l'un sous l'autre #}
        {% set r = s.requests %}{% set defaultTier = 1 %}
        <div class="tiers" data-tiers>
          <div class="tiers-head">
            <h3>{{ r.title }}</h3>
            <p>{{ r.text }}</p>
          </div>
          <div class="tiers-body">
            <div class="tier-control" style="--stops: {{ r.tiers.length }}">
              <label class="tier-label" for="tier-range">{{ r.label }}</label>
              <input type="range" class="tier-range" id="tier-range" min="0" max="{{ r.tiers.length }}" step="1" value="{{ defaultTier }}" aria-valuetext="{{ r.tier.valueText | replace('{n}', r.tiers[defaultTier - 1]) }}">
              <div class="tier-marks">
                <button type="button" class="tier-mark" data-tier-to="0" style="--i: 0" tabindex="-1" aria-hidden="true">{{ r.unit.mark }}</button>{% for n in r.tiers %}
                <button type="button" class="tier-mark" data-tier-to="{{ loop.index }}" style="--i: {{ loop.index }}" tabindex="-1" aria-hidden="true">{{ n }}</button>{% endfor %}
              </div>
            </div>
            <div class="tier-panels" aria-live="polite">
              <div class="tier-panel{% if defaultTier == 0 %} is-active{% endif %}" data-tier="0">
                <p class="tier-name">{{ r.unit.valueText }}</p>
                <p class="price-amount">{{ r.unit.price }}</p>
                <p class="tier-what">{{ r.unit.what }}</p>
                <p class="tier-note">{{ r.unit.note }}</p>
              </div>{% for n in r.tiers %}
              <div class="tier-panel{% if defaultTier == loop.index %} is-active{% endif %}" data-tier="{{ loop.index }}">
                <p class="tier-name">{{ r.tier.valueText | replace('{n}', n) }}</p>
                <p class="price-amount">{{ r.tier.price | replace('{n}', n) }}</p>
                <p class="tier-what">{{ r.tier.what | replace('{n}', n) }}</p>
                <p class="tier-note">{{ r.tier.note | replace('{n}', n) }}</p>
              </div>{% endfor %}
            </div>
          </div>
        </div>
{#- Ce qui compte comme une demande : trois colonnes d'exemples ; sur mobile, une à la fois, choisie par onglet (script.js) #}
        {% set k = s.kinds %}
        <div class="kinds" data-kinds>
          <h3>{{ k.title }}</h3>
          <p class="kinds-rule">{{ k.rule }}</p>
          <div class="kinds-tabs" role="group" aria-label="{{ k.tabsLabel }}">{% for col in k.columns %}
            <button type="button" class="kind-tab" aria-controls="kind-{{ col.id }}" aria-pressed="{{ "true" if loop.first else "false" }}">{{ col.tab }}</button>{% endfor %}
          </div>
          <div class="kinds-cols">{% for col in k.columns %}
            <div class="kind kind-{{ col.id }}{% if loop.first %} is-active{% endif %}" id="kind-{{ col.id }}">
              <p class="kind-title">{{ col.title }}</p>
              <p class="kind-tag">{{ col.tag }}</p>
              <ul>{% for item in col.items %}
                <li>{{ item }}</li>{% endfor %}
              </ul>
{% if col.note %}              <p class="kind-note">{{ col.note }}</p>
{% endif %}            </div>{% endfor %}
          </div>
          <p class="kinds-doubt">{{ k.doubt }}</p>
        </div>
        <div class="quote-notes">{% for note in s.notes %}
          <p><button type="button" class="note-toggle" aria-expanded="false" aria-controls="note-{{ note.id }}">{{ note.title }}</button><span class="note-sep">{{ note.sep or t.colon }}</span><span class="note-body" id="note-{{ note.id }}">{{ note.text }}</span></p>{% endfor %}
        </div>
        <a data-book class="btn quote-btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ s.commitmentsAnchor }}" aria-labelledby="t-engagements">
    <div class="wrap split split-wide">
      <div class="split-text">
        <h2 id="t-engagements">{{ s.commitmentsTitle }}</h2>
        <p>{{ s.commitmentsText }}</p>
      </div>
      <div>
        <ul class="promises">{% for promise in s.promises %}
          <li>{{ promise }}</li>{% endfor %}
        </ul>
        <div class="guarantee">
          <p class="guarantee-title">{{ s.guarantee.title }}</p>
          <p>{{ s.guarantee.text }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="{{ s.safeguardsAnchor }}" aria-labelledby="t-garanties">
    <div class="wrap">
      <h2 id="t-garanties">{{ s.safeguardsTitle }}</h2>
      <p class="section-lede">{{ s.safeguardsLede }}</p>
      <div class="assurances">{% for item in s.safeguardsList %}
        <div>
          <svg class="icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% include "icons/" + item.icon + ".svg" %}</svg>
          <h3>{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </div>{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ t.offerSections.faq.id }}" aria-labelledby="t-faq">
    <div class="wrap faq-wrap">
      <div class="faq-head">
        <h2 id="t-faq">{{ s.faqTitle }}</h2>
        <div class="roles" role="group" aria-labelledby="faq-who">
          <p class="roles-label" id="faq-who">{{ s.faqWho }}</p>
          <div class="roles-list">{% for role in s.roles %}<button type="button" class="role" data-role="{{ role.id }}" aria-pressed="false">{{ role.label }}</button>{% endfor %}</div>
        </div>
      </div>
      <div class="faq">{% for entry in s.faq %}
        <details data-roles="{{ entry.roles }}">
          <summary>{{ entry.q }}</summary>
{% if entry.byCity %}{#- une réponse par ville : seule celle de la ville choisie s'affiche #}{% for city, answer in entry.byCity %}          <p data-city-only="{{ city }}">{{ answer }}</p>
{% endfor %}{% else %}          <p>{{ entry.a }}</p>
{% endif %}        </details>{% endfor %}
      </div>
    </div>
  </section>

  {{ c.cta(t.cta.title, t.cta.text, t.cta.button, "audit", s.emailUs, { name: city.person.name, photo: city.person.photo, text: t.answers, href: routes.about[lang] }) }}

