---
pagination: { data: pages.offer, size: 1, alias: p }
brandFirst: true
og: true
scripts: [script.js, nav.js]
---
{% import "components.njk" as c %}

  <section class="hero grid-paper">
    <div class="wrap">
      <div class="hero-head">
        <h1 class="hero-title">
          <span class="line">{{ s.heroLine1 }}</span>
          <span class="line"><span class="target" id="target">man<span class="ia">ia</span>que</span>{% if s.meaning %}<a class="star" href="#meaning" aria-label="{{ s.meaningLabel }}">*</a>{% endif %}</span>
          <span class="line">{{ s.heroLine3 }}</span>
        </h1>
        <div class="note" aria-hidden="true">
          <p class="note-ask">{{ s.noteAsk }}</p>
          <p class="note-next">{{ s.noteNext }}</p>
        </div>
      </div>
{% if s.meaning %}      <p class="meaning" id="meaning"><span class="star-ref" aria-hidden="true">*</span>{{ s.meaning }}</p>
{% endif %}      <div class="hero-foot">
        <p class="lede">{{ s.lede }}</p>
        <div class="hero-cta">
          <div class="hero-actions">
            <a data-book class="btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
            <a class="link" href="#{{ t.offerSections.pricing.id }}">{{ s.seePricing }}</a>
          </div>
          <a class="who" href="{{ routes.about[lang] }}"><img data-person-photo src="{{ city.person.photo }}" width="32" height="32" alt=""><span><span data-person-name>{{ city.person.name }}</span> {{ s.answers }}</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="showcase" role="img" aria-label="{{ s.showcaseLabel }}">
{#- Deux bandes de maquettes d'écran (src/_includes/showcase/) qui défilent sans fin : chacune est répétée, la copie cachée aux lecteurs d'écran -#}
{% for row in [["sales", "jobs", "pipeline", "scanner", "invoices", "deliveries", "booking", "support"], ["schedule", "dashboard", "inventory", "team", "deals", "bookings", "timeClock", "workshop"]] %}
    <div class="showcase-row{% if not loop.first %} showcase-rev{% endif %}"><div class="showcase-track">{% set mockups %}{% for id in row %}{% set m = s.showcase[id] %}{% include "showcase/" + id + ".njk" %}{% endfor %}{% endset %}{{ mockups }}<div class="showcase-dup" aria-hidden="true">{{ mockups }}</div></div></div>
{%- endfor %}
  </section>

  <section class="section section-alt" id="{{ t.offerSections.howItWorks.id }}" aria-labelledby="t-etapes">
    <div class="wrap">
      <h2 id="t-etapes">{{ s.stepsTitle }}</h2>
      <ol class="steps">{% for step in s.steps %}
        <li>
          <h3><button type="button" class="step-toggle" aria-expanded="false" aria-controls="step-desc-{{ loop.index }}">{{ step.title }}</button></h3>
          <p class="step-meta">{{ step.meta }}</p>
          <p class="step-desc" id="step-desc-{{ loop.index }}">{{ step.text }}</p>
{% if loop.first %}          <a data-book class="btn btn-small step-btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
{% endif %}        </li>{% endfor %}
      </ol>
    </div>
  </section>

  <section class="section" id="{{ t.offerSections.pricing.id }}" aria-labelledby="t-tarifs">
    <div class="wrap">
      <h2 id="t-tarifs">{{ s.pricingTitle }}</h2>
      <p class="section-lede">{{ s.pricingLede }}</p>
      <div class="quote">
        <table class="quote-table">
          <caption class="visually-hidden">{{ s.plansCaption }}</caption>
          <thead>
            <tr>
              <td></td>{% for plan in s.plans %}
              <th scope="col">{{ plan }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>{% for row in s.planRows %}
            <tr><th scope="row">{{ row.label }}</th>{% for value in row.values %}<td{% if row.num %} class="num"{% endif %}>{{ value }}</td>{% endfor %}</tr>{% endfor %}
          </tbody>
        </table>
{#- Sur mobile, le tableau devient une carte par formule : mêmes textes, lus de haut en bas (l'un ou l'autre est affiché, jamais les deux) #}
        <div class="plans">{% for plan in s.plans %}{% set i = loop.index0 %}
          <div class="plan">
            <p class="plan-name">{{ plan }}</p>
            <dl>{% for row in s.planRows %}
              <div{% if row.num %} class="num"{% endif %}><dt>{{ row.label }}</dt><dd>{{ row.values[i] }}</dd></div>{% endfor %}
            </dl>
          </div>{% endfor %}
        </div>
        <div class="quote-notes">{% for note in s.notes %}
          <p><button type="button" class="note-toggle" aria-expanded="false" aria-controls="note-{{ note.id }}">{{ note.title }}</button><span class="note-sep">{{ note.sep or t.colon }}</span><span class="note-body" id="note-{{ note.id }}">{{ note.text }}</span></p>{% endfor %}
        </div>
        <a data-book class="btn quote-btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ s.commitmentsAnchor }}" aria-labelledby="t-engagements">
    <div class="wrap split split-wide">
      <div class="split-text">
        <h2 id="t-engagements">{{ s.commitmentsTitle }}</h2>
        <p>{{ s.commitmentsText }}</p>
      </div>
      <div>
        <ul class="promises">{% for promise in s.promises %}
          <li>{{ promise }}</li>{% endfor %}
        </ul>
        <div class="guarantee">
          <p class="guarantee-title">{{ s.guarantee.title }}</p>
          <p>{{ s.guarantee.text }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="{{ s.safeguardsAnchor }}" aria-labelledby="t-garanties">
    <div class="wrap">
      <h2 id="t-garanties">{{ s.safeguardsTitle }}</h2>
      <p class="section-lede">{{ s.safeguardsLede }}</p>
      <div class="assurances">{% for item in s.safeguardsList %}
        <div>
          <svg class="icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% include "icons/" + item.icon + ".svg" %}</svg>
          <h3>{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </div>{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="{{ t.offerSections.faq.id }}" aria-labelledby="t-faq">
    <div class="wrap faq-wrap">
      <div class="faq-head">
        <h2 id="t-faq">{{ s.faqTitle }}</h2>
        <div class="roles" role="group" aria-labelledby="faq-who">
          <p class="roles-label" id="faq-who">{{ s.faqWho }}</p>
          <div class="roles-list">{% for role in s.roles %}<button type="button" class="role" data-role="{{ role.id }}" aria-pressed="false">{{ role.label }}</button>{% endfor %}</div>
        </div>
      </div>
      <div class="faq">{% for entry in s.faq %}
        <details data-roles="{{ entry.roles }}">
          <summary>{{ entry.q }}</summary>
{% if entry.byCity %}{#- une réponse par ville : seule celle de la ville choisie s'affiche #}{% for city, answer in entry.byCity %}          <p data-city-only="{{ city }}">{{ answer }}</p>
{% endfor %}{% else %}          <p>{{ entry.a }}</p>
{% endif %}        </details>{% endfor %}
      </div>
    </div>
  </section>

  {{ c.cta(t.cta.title, t.cta.text, t.cta.button, "audit", s.emailUs) }}

