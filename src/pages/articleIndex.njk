---
pagination: { data: pages.articleIndex, size: 1, alias: p }
mainClass: section
section: articleIndex
scripts: [nav.js]
---

  <div class="wrap">
    <h1 class="articles-title">{{ s.articlesTitle }}</h1>
    <p class="section-lede">{{ s.sectionLede }}</p>

    <ul class="article-list">
      {% for item in s.articleList %}{% if not loop.first %}
      {% endif %}<li>
        <a class="article-card" href="{{ item.articleCardHref }}">{{ item.articleCard }}</a>
      </li>{% endfor %}
    </ul>
  </div>
