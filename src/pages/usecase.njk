---
pagination: { data: pages.usecase, size: 1, alias: p }
scripts: [nav.js]
---
{% import "components.njk" as c %}{% set screenLabel = s.screenLabel or (s.exampleScreen + (s.title | lowerFirst)) %}

  <section class="section uc-hero" aria-labelledby="t-uc">
    <div class="wrap">
      <a class="uc-back" href="{{ routes.usecaseIndex[lang] }}">{{ s.ucBack }}</a>
      <h1 class="uc-title" id="t-uc">{{ s.headline }}</h1>
      <p class="uc-lede">{{ s.lede }}</p>
      <a data-book class="btn" target="_blank" rel="noopener">{{ t.bookFree }}</a>
      <ul class="uc-facts">{% for item in s.ucFacts %}<li>{{ item }}</li>{% endfor %}</ul>
    </div>
  </section>

  <section class="uc-visual" aria-label="{{ screenLabel }}">
    <div class="wrap">
      <figure class="qt-figure">
        <div class="qt" role="img" aria-label="{{ screenLabel }}">
          <div class="qt-chrome"><i></i><i></i><i></i></div>
          <div class="{{ s.appClass }}">{% include "usecases/" + p.id + ".njk" %}</div>
        </div>
        <figcaption>{{ s.caption }}</figcaption>
      </figure>
    </div>
  </section>

  {{ c.cta(s.audit, s.auditP, t.cta.button) }}

