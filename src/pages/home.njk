---
pagination: { data: pages.home, size: 1, alias: p }
brandFirst: true
og: true
variant: home
mainClass: map-stage
scripts: [map.js]
---

  <h1 class="map-title">{{ s.mapTitle }}</h1>
  <div class="map-scroll">
    <div class="world">
      <img class="world-land" src="/images/world.svg" width="360" height="142" alt="">
      <ul class="cities" aria-label="{{ s.worldCitiesAriaLabel }}">
        <li class="city" data-anchor="center" style="--x: 51.49%; --y: 28.66%">
          <a href="/offre/?ville=marseille" data-person-of="marseille">{{ s.cityA }}</a>
        </li>
        <li class="city" data-anchor="start" style="--x: 37.05%; --y: 75.74%">
          <a href="/pt/oferta/?ville=sao-paulo" data-person-of="sao-paulo">{{ s.cityA2 }}</a>
        </li>
        <li class="city" data-anchor="end" style="--x: 57.79%; --y: 77.61%">
          <a href="/en/offer/?ville=johannesburg" data-person-of="johannesburg">{{ s.cityA3 }}</a>
        </li>
      </ul>
    </div>
  </div>
  <nav class="uses-marquee" aria-label="{{ s.usesMarqueeAriaLabel }}">
