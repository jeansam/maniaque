---
pagination: { data: pages.home, size: 1, alias: p }
brandFirst: true
og: true
variant: home
mainClass: map-stage
scripts: [map.js]
---

  <h1 class="map-title">{{ s.mapTitle }}</h1>
  <div class="map-scroll">
    <div class="world">
      <img class="world-land" src="/images/world.svg" width="360" height="142" alt="">
      <ul class="cities" aria-label="{{ s.worldCitiesAriaLabel }}">
        {% for city in s.cities %}{% if not loop.first %}
        {% endif %}<li class="city" data-anchor="{{ city.dataAnchor }}" style="{{ city.style }}">
          <a href="{{ city.aHref }}" data-person-of="{{ city.aDataPersonOf }}">{{ city.a }}</a>
        </li>{% endfor %}
      </ul>
    </div>
  </div>
  <nav class="uses-marquee" aria-label="{{ s.usesMarqueeAriaLabel }}">
    <div class="marquee-row"><div class="marquee-track"><ul><li><a href="{{ routes.usecaseIndex[lang] }}crm/">CRM</a></li><li><a href="{{ s.marqueeTrackAHref2 }}">{{ s.marqueeTrackA }}</a></li><li><a href="{{ s.marqueeTrackAHref3 }}">{{ s.marqueeTrackA2 }}</a></li><li><a href="{{ s.marqueeTrackAHref4 }}">{{ s.marqueeTrackA3 }}</a></li><li><a href="{{ s.marqueeTrackAHref5 }}">{{ s.marqueeTrackA4 }}</a></li><li><a href="{{ s.marqueeTrackAHref6 }}">{{ s.marqueeTrackA5 }}</a></li><li><a href="{{ s.marqueeTrackAHref7 }}">{{ s.marqueeTrackA6 }}</a></li><li><a href="{{ s.marqueeTrackAHref8 }}">{{ s.marqueeTrackA7 }}</a></li><li aria-hidden="true"><a href="{{ routes.usecaseIndex[lang] }}crm/" tabindex="-1">CRM</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref10 }}" tabindex="-1">{{ s.marqueeTrackA8 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref11 }}" tabindex="-1">{{ s.marqueeTrackA9 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref12 }}" tabindex="-1">{{ s.marqueeTrackA10 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref13 }}" tabindex="-1">{{ s.marqueeTrackA11 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref14 }}" tabindex="-1">{{ s.marqueeTrackA12 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref15 }}" tabindex="-1">{{ s.marqueeTrackA13 }}</a></li><li aria-hidden="true"><a href="{{ s.marqueeTrackAHref16 }}" tabindex="-1">{{ s.marqueeTrackA14 }}</a></li></ul><ul aria-hidden="true"><li><a href="{{ routes.usecaseIndex[lang] }}crm/" tabindex="-1">CRM</a></li><li><a href="{{ s.marqueeTrackAHref18 }}" tabindex="-1">{{ s.marqueeTrackA15 }}</a></li><li><a href="{{ s.marqueeTrackAHref19 }}" tabindex="-1">{{ s.marqueeTrackA16 }}</a></li><li><a href="{{ s.marqueeTrackAHref20 }}" tabindex="-1">{{ s.marqueeTrackA17 }}</a></li><li><a href="{{ s.marqueeTrackAHref21 }}" tabindex="-1">{{ s.marqueeTrackA18 }}</a></li><li><a href="{{ s.marqueeTrackAHref22 }}" tabindex="-1">{{ s.marqueeTrackA19 }}</a></li><li><a href="{{ s.marqueeTrackAHref23 }}" tabindex="-1">{{ s.marqueeTrackA20 }}</a></li><li><a href="{{ s.marqueeTrackAHref24 }}" tabindex="-1">{{ s.marqueeTrackA21 }}</a></li><li><a href="{{ routes.usecaseIndex[lang] }}crm/" tabindex="-1">CRM</a></li><li><a href="{{ s.marqueeTrackAHref26 }}" tabindex="-1">{{ s.marqueeTrackA22 }}</a></li><li><a href="{{ s.marqueeTrackAHref27 }}" tabindex="-1">{{ s.marqueeTrackA23 }}</a></li><li><a href="{{ s.marqueeTrackAHref28 }}" tabindex="-1">{{ s.marqueeTrackA24 }}</a></li><li><a href="{{ s.marqueeTrackAHref29 }}" tabindex="-1">{{ s.marqueeTrackA25 }}</a></li><li><a href="{{ s.marqueeTrackAHref30 }}" tabindex="-1">{{ s.marqueeTrackA26 }}</a></li><li><a href="{{ s.marqueeTrackAHref31 }}" tabindex="-1">{{ s.marqueeTrackA27 }}</a></li><li><a href="{{ s.marqueeTrackAHref32 }}" tabindex="-1">{{ s.marqueeTrackA28 }}</a></li></ul></div></div>
    <div class="marquee-row marquee-rev"><div class="marquee-track"><ul>{% for item in s.items %}<li><a href="{{ item.aHref }}">{{ item.a }}</a></li>{% endfor %}{% for item in s.items2 %}<li aria-hidden="true"><a href="{{ item.aHref }}" tabindex="-1">{{ item.a }}</a></li>{% endfor %}</ul><ul aria-hidden="true">{% for item in s.items3 %}<li><a href="{{ item.aHref }}" tabindex="-1">{{ item.a }}</a></li>{% endfor %}</ul></div></div>
  </nav>
