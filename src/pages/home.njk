---
pagination: { data: pages.home, size: 1, alias: p }
brandFirst: true
og: true
variant: home
mainClass: map-stage
scripts: [map.js]
---

  <h1 class="map-title">{{ s.mapTitle }}</h1>
  <div class="map-scroll">
    <div class="world">
      <img class="world-land" src="/images/world.svg" width="360" height="142" alt="">
      <ul class="cities" aria-label="{{ s.worldCitiesAriaLabel }}">{% for c in cities | values %}
        <li class="city" data-anchor="{{ c.map.anchor }}" style="--x: {{ c.map.x }}; --y: {{ c.map.y }}">
          <a href="{{ routes.offer[c.lang] }}?ville={{ c.id }}" data-person-of="{{ c.id }}">
            <span class="city-dot" aria-hidden="true"></span>
            <span class="city-card"><img data-person-photo draggable="false" src="{{ c.person.photo }}" width="56" height="56" alt=""><span><strong data-person-name>{{ c.person.name }}</strong><span>{{ s.role }}</span><span class="city-name">{{ c.name[lang] }}</span></span><svg class="city-go" viewBox="0 0 30 16" width="30" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3.5 7.5 8 3 12.5"/><path d="M12 3.5 16.5 8 12 12.5"/><path d="M21 3.5 25.5 8 21 12.5"/></svg></span>
          </a>
        </li>{% endfor %}
      </ul>
    </div>
  </div>
  <nav class="uses-marquee" aria-label="{{ s.usesMarqueeAriaLabel }}">
{#- Deux rangées de cas d'usage qui défilent sans fin : chaque lien est répété, et les copies sont cachées aux lecteurs d'écran (aria-hidden) et au clavier (tabindex) -#}
{% for row in [[0, 8], [8, 15]] %}
    <div class="marquee-row{% if not loop.first %} marquee-rev{% endif %}"><div class="marquee-track">{% for ul in [{ copies: [[false, false], [true, true]] }, { hidden: true, copies: [[false, true], [false, true]] }] %}<ul{% if ul.hidden %} aria-hidden="true"{% endif %}>{% for copy in ul.copies %}{% for uc in (usecases | values).slice(row[0], row[1]) %}<li{% if copy[0] %} aria-hidden="true"{% endif %}><a href="{{ routes["usecase:" + uc.id][lang] }}"{% if copy[1] %} tabindex="-1"{% endif %}>{{ uc.strings.title | tr(lang) }}</a></li>{% endfor %}{% endfor %}</ul>{% endfor %}</div></div>
{%- endfor %}
  </nav>
