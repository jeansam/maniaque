---
pagination: { data: pages.portfolioAccess, size: 1, alias: p }
section: about
noindex: true
# Le portfolio est celui de Jean-Samuel : la page montre Marseille, quelle que soit la ville choisie
pageCity: marseille
scripts: [nav.js]
---
{#- worker.js sert cette page à la place du portfolio tant que le mot de passe n'est pas donné. Le formulaire
    renvoie le mot de passe à l'adresse du portfolio ; après une erreur, worker.js retire hidden du message -#}
  <section class="section portfolio-access" aria-labelledby="t-access">
    <div class="wrap">
      <a class="back-link" href="{{ routes.about[lang] }}#portfolio"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ s.back }}</a>
      <h1 class="about-title" id="t-access">{{ s.heading }}</h1>
      <p class="section-lede">{{ s.text }}</p>
      <form class="access-form" method="post" action="{{ routes.portfolio[lang] }}">
        <label for="access-password">{{ s.label }}</label>
        <div class="access-row">
          <input id="access-password" name="password" type="password" autocomplete="current-password" required autofocus>
          <button class="btn" type="submit">{{ s.submit }}</button>
        </div>
        <p class="access-error" role="alert" data-access-error hidden>{{ s.error }}</p>
      </form>
      <p class="access-ask">{{ s.ask }}</p>
    </div>
  </section>
