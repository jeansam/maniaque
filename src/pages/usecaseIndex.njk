---
pagination: { data: pages.usecaseIndex, size: 1, alias: p }
section: usecaseIndex
scripts: [nav.js]
---
{% import "components.njk" as c %}

  <section class="section uses-page" aria-labelledby="t-uses">
    <div class="wrap">
      <h1 class="about-title" id="t-uses">{{ s.uses }}</h1>
      <p class="section-lede">{{ s.usesSectionLede }}</p>
      <ul class="uses">
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="10" width="34" height="28" rx="3" stroke="#142850"/><circle cx="18" cy="21" r="4" stroke="#142850"/>{% for path in s.paths %}<path d="{{ path.d }}" stroke="#142850"/>{% endfor %}<circle cx="38" cy="10" r="4" fill="#D2251B" stroke="#D2251B"/></svg><h2>CRM</h2>{% for item in s.items %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ p.url }}crm/">{{ s.usesLink }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH2 }}</h2>{% for item in s.items2 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref2 }}">{{ s.usesLink2 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="10" width="34" height="31" rx="3" stroke="#142850"/>{% for path in s.paths2 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}<circle cx="24" cy="28" r="1.5" fill="#D2251B" stroke="#D2251B"/></svg><h2>{{ s.usesH22 }}</h2>{% for item in s.items3 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref3 }}">{{ s.usesLink3 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="8" width="36" height="32" rx="3" stroke="#142850"/><path d="M6 15h36" stroke="#142850"/><circle cx="24" cy="25" r="4" stroke="#D2251B"/><path d="M16 36c1.5-4 4.5-5.5 8-5.5s6.5 1.5 8 5.5" stroke="#D2251B"/></svg><h2>{{ s.usesH23 }}</h2>{% for item in s.items4 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref4 }}">{{ s.usesLink4 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for rect in s.rects %}<rect x="{{ rect.x }}" y="{{ rect.y }}" width="15" height="14" stroke="#142850"/>{% endfor %}<path d="M13 26v5M30 26v5M21.5 10v5" stroke="#D2251B"/></svg><h2>{{ s.usesH24 }}</h2>{% for item in s.items5 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref5 }}">{{ s.usesLink5 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.paths3 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}<circle cx="24" cy="34" r="2" fill="#D2251B" stroke="#D2251B"/></svg><h2>{{ s.usesH25 }}</h2>{% for item in s.items6 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref6 }}">{{ s.usesLink6 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon2 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH26 }}</h2>{% for item in s.items7 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref7 }}">{{ s.usesLink7 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon3 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH27 }}</h2>{% for item in s.items8 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref8 }}">{{ s.usesLink8 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17" stroke="#142850"/>{% for path in s.paths4 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH28 }}</h2>{% for item in s.items9 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref9 }}">{{ s.usesLink9 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon4 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH29 }}</h2>{% for item in s.items10 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref10 }}">{{ s.usesLink10 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="17" r="7" stroke="#142850"/>{% for path in s.paths5 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH210 }}</h2>{% for item in s.items11 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref11 }}">{{ s.usesLink11 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 10h32a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H22l-9 7v-7H8a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2z" stroke="#142850"/>{% for circle in s.circles %}<circle cx="{{ circle.cx }}" cy="22" r="1.5" fill="#D2251B" stroke="#D2251B"/>{% endfor %}</svg><h2>{{ s.usesH211 }}</h2>{% for item in s.items12 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref12 }}">{{ s.usesLink12 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon5 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH212 }}</h2>{% for item in s.items13 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref13 }}">{{ s.usesLink13 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{% for path in s.usesIcon6 %}<path d="{{ path.d }}" stroke="{{ path.stroke }}"/>{% endfor %}</svg><h2>{{ s.usesH213 }}</h2>{% for item in s.items14 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref14 }}">{{ s.usesLink14 }}</a></li>
        <li><svg class="uses-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="11" y="12" width="26" height="30" rx="3" stroke="#142850"/><path d="M20 6h8v8h-8z" stroke="#D2251B"/><circle cx="24" cy="25" r="4" stroke="#142850"/><path d="M17 36c1.5-3.5 4-5 7-5s5.5 1.5 7 5" stroke="#142850"/></svg><h2>{{ s.usesH214 }}</h2>{% for item in s.items15 %}<p{% if item.usesQuote %} class="uses-quote"{% endif %}>{{ item.label }}</p>{% endfor %}<a class="uses-link" href="{{ s.usesLinkHref15 }}">{{ s.usesLink15 }}</a></li>
      </ul>
      <p class="uses-more">{{ s.usesMore }}</p>
    </div>
  </section>

  {{ c.cta(s.audit, s.auditP, s.auditBtn) }}

