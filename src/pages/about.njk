---
pagination: { data: pages.about, size: 1, alias: p }
section: about
scripts: [nav.js]
---
{% import "components.njk" as c %}

  <section class="section about" id="{{ s.anchor }}" aria-labelledby="t-fondateur">
    <div class="wrap split">
      <div class="split-text">
        <h1 class="about-title" id="t-fondateur">{{ s.heading }}</h1>
{% for c in cities | values %}        <figure class="portrait grid-paper" data-city-only="{{ c.id }}">
          <img src="{{ c.person.portrait }}" width="640" height="723" alt="{{ s.people[c.id].alt }}" loading="lazy">
        </figure>
{% endfor %}      </div>
{#- Une présentation par ville : celle de la ville choisie s'affiche (data-city-only) #}
{% for c in cities | values %}{% set who = s.people[c.id] %}      <div class="founder" data-city-only="{{ c.id }}">
{% for para in who.bio or [who.intro, s.partnerMethod] %}        <p>{{ para }}</p>
{% endfor %}        <p class="founder-sign">{{ who.sign or (s.partnerSign | replace("{name}", c.person.fullName) | replace("{city}", c.name[lang])) }}</p>
{% if who.previous %}        <p class="founder-prev">{{ who.previous }}</p>
{% endif %}        <div class="founder-meta">
          <a class="li-link" aria-label="{{ s.linkedinLabel | replace("{name}", c.person.fullName) }}" href="{{ c.person.linkedin }}" target="_blank" rel="noopener">{% include "icons/linkedin.svg" %}</a>
          <span class="place" aria-label="{{ s.basedIn | replace("{city}", c.name[lang]) }}">{% include "icons/pin.svg" %}<span>{{ c.name[lang] }}</span></span>
        </div>
      </div>
{% endfor %}    </div>
  </section>

  {{ c.cta(t.cta.title, t.cta.text, t.cta.button) }}

