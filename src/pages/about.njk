---
pagination: { data: pages.about, size: 1, alias: p }
section: about
scripts: [nav.js]
---


  <section class="section about" id="{{ s.fondateurId }}" aria-labelledby="{{ s.fondateurAriaLabelledby }}">
    <div class="wrap split">
      <div class="split-text">
        <h1 class="about-title" id="{{ s.splitTextFondateurId }}">{{ s.splitTextFondateur }}</h1>
        <figure class="portrait grid-paper" data-city-only="marseille">
          <img src="/images/jean-samuel.webp" width="640" height="723" alt="{{ s.portraitImgAlt }}" loading="lazy">
        </figure>
        <figure class="portrait grid-paper" data-city-only="sao-paulo">
          <img src="/images/eliakim-oliveira.webp" width="640" height="723" alt="{{ s.portraitImgAlt2 }}" loading="lazy">
        </figure>
        <figure class="portrait grid-paper" data-city-only="johannesburg">
          <img src="/images/nthuseni-mathaga.webp" width="640" height="723" alt="{{ s.portraitImgAlt3 }}" loading="lazy">
        </figure>
      </div>
      <div class="founder" data-city-only="marseille">
        <p>{{ s.founderP }}</p>
        <p>{{ s.founderP2 }}</p>
        <p class="founder-sign">{{ s.founderSign }}</p>
        <p class="founder-prev">{{ s.founderPrev }}</p>
        <div class="founder-meta">
          <a class="li-link" aria-label="{{ s.founderMetaLiLinkAriaLabel }}" href="https://www.linkedin.com/in/jsjequier" target="_blank" rel="noopener"><svg class="li-icon" viewBox="0 0 448 512" width="18" height="20" aria-hidden="true" fill="currentColor"><!--! Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2024 Fonticons, Inc. --><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg></a>
          <span class="place" aria-label="{{ s.founderMetaPlaceAriaLabel }}">{{ s.founderMetaPlace }}</span>
        </div>
      </div>
      <div class="founder" data-city-only="sao-paulo">
        <p>{{ s.founderP3 }}</p>
        <p>{{ s.founderP4 }}</p>
        <p class="founder-sign">Eliakim Oliveira, Maniaque São Paulo</p>
        <div class="founder-meta">
          <a class="li-link" aria-label="{{ s.founderMetaLiLinkAriaLabel2 }}" href="https://www.linkedin.com/in/eliakim-oliveira/" target="_blank" rel="noopener"><svg class="li-icon" viewBox="0 0 448 512" width="18" height="20" aria-hidden="true" fill="currentColor"><!--! Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2024 Fonticons, Inc. --><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg></a>
          <span class="place" aria-label="{{ s.founderMetaPlaceAriaLabel2 }}"><svg class="pin-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5" fill="#D2251B" stroke="#D2251B"/></svg><span>São Paulo</span></span>
        </div>
      </div>
      <div class="founder" data-city-only="johannesburg">
        <p>{{ s.founderP5 }}</p>
        <p>{{ s.founderP6 }}</p>
        <p class="founder-sign">{{ s.founderSign2 }}</p>
        <div class="founder-meta">
          <a class="li-link" aria-label="{{ s.founderMetaLiLinkAriaLabel3 }}" href="https://www.linkedin.com/in/nmathaga/" target="_blank" rel="noopener"><svg class="li-icon" viewBox="0 0 448 512" width="18" height="20" aria-hidden="true" fill="currentColor"><!--! Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2024 Fonticons, Inc. --><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg></a>
          <span class="place" aria-label="{{ s.founderMetaPlaceAriaLabel3 }}">{{ s.founderMetaPlace2 }}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cta grid-paper" aria-labelledby="t-audit">
    <div class="wrap">
      <h2 id="t-audit">{{ s.audit }}</h2>
      <p>{{ s.auditP }}</p>
      <a data-book class="btn" target="_blank" rel="noopener">{{ s.auditBtn }}</a>
    </div>
  </section>

