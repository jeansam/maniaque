---
pagination: { data: pages.article, size: 1, alias: p }
og: article
mainClass: article
section: articleIndex
scripts: [nav.js]
---
{% import "components.njk" as c %}
  <div class="wrap article-wrap">
    <p class="article-back"><a class="link" href="{{ routes.articleIndex[lang] }}">{{ s.articleBackLink }}</a></p>
    <h1 class="article-title">{{ s.articleTitle }}</h1>
    <p class="article-meta">{{ s.articleMeta }}</p>
  </div>

  <figure class="article-figure wrap">
    <img src="{{ s.articleFigureImgSrc }}" width="1600" height="840" alt="{{ s.articleFigureImgAlt }}">
    <figcaption>{{ s.articleFigureFigcaption }}</figcaption>
  </figure>

  <article class="wrap article-wrap prose">{% include "articles/" + p.id + ".njk" %}</article>

  {{ c.cta(t.cta.title, t.cta.text, t.cta.button) }}
