// Hébergement sur Cloudflare Workers : Cloudflare lance `npm run build` puis `npx wrangler deploy`,
// qui met en ligne le dossier _site/ et worker.js
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maniaque",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // Seul l'accueil passe par worker.js (redirection selon la langue) ; le reste est servi directement, sans limite de requêtes
    "run_worker_first": ["/"]
  },
  "observability": { "enabled": true }
}
